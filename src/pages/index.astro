---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const featuredProjects = [
  {
    title: 'SiteWatch AI - Computer Vision Safety Monitoring, Verified by an RLM Agent',
    description:
      'Deterministic computer vision (YOLO11s + ByteTrack, calibrated to floor meters) fires forklift-proximity, zone-dwell and speed rules on every frame. A Prime Agent RLM verifies each firing by running Python over the raw tracks, and a plain-code gate recomputes its numbers before anything is recorded. Live demo replays the real pipeline output and agent sessions.',
    tags: ['Python', 'Computer Vision', 'YOLO', 'Verified Agent', 'Evaluation'],
    status: 'featured' as const,
    timeframe: 'Sep 2026',
    metrics: ['Live demo (GitHub Pages)', 'Agent eval: 26/30 first pass; ~$0.002 per incident', 'Gate caught a real agent misclassification'],
    github: 'https://github.com/PCSchmidt/sitework-ai',
    demo: 'https://pcschmidt.github.io/sitework-ai/',
    demoLabel: 'Live',
    evidence: 'https://github.com/PCSchmidt/sitework-ai/blob/main/docs/eval-m5-agent-slow-path.md',
    guide: 'https://github.com/PCSchmidt/sitework-ai#verify-the-claims-a-reviewers-path',
  },
  {
    title: 'Chokepoint - Provenance-Aware Transportation Intelligence',
    description:
      'Deterministic maritime metrics over reviewed geofences, extended to air and land through the same admission-gate discipline, with an agent that answers only from evaluator-approved evidence. Live fixture-mode demo with a PWA offline shell.',
    tags: ['TypeScript', 'CesiumJS', 'Verified Agent', 'Evaluation', 'Geospatial'],
    status: 'featured' as const,
    timeframe: 'Sep 2026 - Present',
    metrics: ['Live demo (GitHub Pages)', '341 offline tests; groundedness 25/25', 'Evaluator rejects causal, threat, and fabricated claims'],
    github: 'https://github.com/PCSchmidt/chokepoint_app',
    demo: 'https://pcschmidt.github.io/chokepoint_app/',
    demoLabel: 'Live',
    evidence: 'https://github.com/PCSchmidt/chokepoint_app/tree/main/evaluation-reports',
    guide: 'https://github.com/PCSchmidt/chokepoint_app#verify-the-claims-a-reviewers-path',
  },
  {
    title: 'Meridian - Agent Harness for AI-Assisted Development',
    description:
      'An agent harness that enforces rules an AI coding agent cannot talk its way past: when a gate check fails, a shell hook blocks the next action, and an independent evaluator subagent scores each gate in a fresh context so the agent never grades its own work.',
    tags: ['Bash', 'Claude Code', 'Agent Harness', 'LLM Evaluation', 'Hooks'],
    status: 'featured' as const,
    timeframe: 'May 2026 - Present',
    metrics: ['Self-grading gap closed: 5.5 -> 2.5 (-3.0 pts)', '240 assertions across 18 suites', 'Dogfooded on 2 production projects'],
    github: 'https://github.com/PCSchmidt/meridian',
    evidence: 'https://github.com/PCSchmidt/meridian/blob/main/experiment/GENERATOR_EVALUATOR_VALIDATION.md',
    guide: 'https://github.com/PCSchmidt/meridian/blob/main/DEMO_GUIDE.md',
    paper: 'https://github.com/PCSchmidt/meridian/blob/main/MERIDIAN_ARCHITECTURE_DECISIONS.md',
  },
  {
    title: 'Hard Power Intelligence - Markets Intelligence Engine',
    description:
      'Turns SEC filings, federal contract awards, and energy and regulatory releases into source-attributed, confidence-graded briefings across AI infrastructure, defense, and energy. An eval gate checks for fabrication before publish, and entity resolution links each event to the company behind it. Live and publishing daily.',
    tags: ['Next.js', 'FastAPI', 'Supabase', 'pgvector', 'RAG', 'Entity Resolution'],
    status: 'featured' as const,
    timeframe: 'Jun 2026 - Present',
    metrics: ['Live: Next.js + FastAPI + Supabase', 'Entity resolver: 1.0 precision / 1.0 recall', '3 desks, 4 live sources, daily cron'],
    github: 'https://github.com/PCSchmidt/HardPowerIntelligence',
    demo: 'https://hardpowerintel.com/',
    demoLabel: 'Live',
    evidence: 'https://hardpowerintel.com/desk/defense',
    guide: 'https://github.com/PCSchmidt/HardPowerIntelligence/blob/main/DEMO_GUIDE.md',
    paper: 'https://github.com/PCSchmidt/HardPowerIntelligence/blob/main/docs/PHILOSOPHY.md',
  },
];
---

<Layout title="Chris Schmidt — ML Engineer, Verified AI Systems">
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-text">
          <h1>Chris Schmidt</h1>
          <p class="hero-subtitle">Machine Learning Engineer, HII Mission Technologies</p>
          <p class="hero-desc">
            I build AI systems that are checked before they are trusted: the consequential decision stays in deterministic code, and anything a model produces passes an independent gate first. Every result is measured, including the ones that came back negative.
          </p>
          <p class="hero-desc">
            Five years at HII Mission Technologies across data engineering, software engineering, and ML engineering. Currently supporting the F-35 Joint Program Office's data modernization initiative on AWS GovCloud. Active security clearance.
          </p>
          <p class="hero-desc">
            MS in Applied Mathematics (Towson University, 2021). Pursuing an MS in AI Engineering at Johns Hopkins University, part-time (expected May 2029). The projects here are self-directed builds, several prompted by JHU coursework.
          </p>
          <div class="hero-cta">
            <a href="/projects" class="btn btn-primary">View Projects</a>
            <a href="/resume" class="btn btn-outline">Resume</a>
          </div>
          <div class="social-links">
            <a href="https://github.com/PCSchmidt" class="social-link" target="_blank" rel="noopener">
              GitHub
            </a>
            <a href="https://www.linkedin.com/in/chris-schmidt-94526a10/" class="social-link" target="_blank" rel="noopener">
              LinkedIn
            </a>
            <a href="mailto:p.christopher.schmidt@gmail.com" class="social-link" id="email-link" onclick="if(!this.dataset.revealed){event.preventDefault();this.textContent='p.christopher.schmidt@gmail.com';this.dataset.revealed='1';}">Email</a>
          </div>
        </div>
        <div class="hero-image-wrap">
          <img
            src="/images/MyImage.jpg"
            alt="Chris Schmidt"
            class="hero-image"
            width="260"
            height="260"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- About strip -->
  <section class="about-strip">
    <div class="container">
      <div class="about-chips">
        <div class="about-chip">
          <span class="chip-icon">🎓</span>
          <span>MS AI Engineering (in progress), Johns Hopkins</span>
        </div>
        <div class="about-chip">
          <span class="chip-icon">📐</span>
          <span>MS Applied Mathematics</span>
        </div>
        <div class="about-chip">
          <span class="chip-icon">🔒</span>
          <span>Active Security Clearance</span>
        </div>
        <div class="about-chip">
          <span class="chip-icon">✅</span>
          <span>Verified Agents &amp; Evaluation</span>
        </div>
        <div class="about-chip">
          <span class="chip-icon">👁️</span>
          <span>Computer Vision &amp; Geospatial ML</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Currently Exploring -->
  <section class="exploring-strip">
    <div class="container">
      <p class="exploring-label">Currently exploring</p>
      <div class="exploring-chips">
        <div class="exploring-chip">
          <span>Deterministic gates on LLM and agent output</span>
          <span class="exploring-status built">built</span>
        </div>
        <div class="exploring-chip">
          <span>Computer vision with calibrated, verifiable measurement</span>
          <span class="exploring-status built">built</span>
        </div>
        <div class="exploring-chip">
          <span>Evaluator-gated agents over geospatial data</span>
          <span class="exploring-status building">building</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Projects -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Selected Projects</h2>
      <p class="section-intro">
        Four systems built on one idea: deterministic decisions, independently checked AI.
        Each is written up as a case study with problem context, approach, and measured outcomes.
      </p>
      <div class="projects-grid">
        {
          featuredProjects.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              tags={project.tags}
              status={project.status}
              metrics={project.metrics}
              github={project.github}
              demo={project.demo}
              evidence={project.evidence}
              guide={project.guide}
              timeframe={project.timeframe}
              paper={project.paper}
              notebook={project.notebook}
            />
          ))
        }
      </div>
      <div class="projects-cta">
        <a href="/projects" class="btn btn-outline">View All Projects →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    padding: 5rem 0 3rem;
    background: linear-gradient(to bottom, #ffffff, #f9fafb);
    border-bottom: 1px solid #e5e7eb;
  }

  .hero-grid {
    display: flex;
    align-items: center;
    gap: 3rem;
  }

  .hero-text {
    flex: 1;
    min-width: 280px;
  }

  .hero-subtitle {
    font-size: 1.05rem;
    font-weight: 600;
    color: #374151;
    margin-bottom: 1.25rem;
  }

  .hero-desc {
    font-size: 0.95rem;
    color: #4b5563;
    margin-bottom: 0.75rem;
    max-width: 520px;
    line-height: 1.75;
  }

  .hero-cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .social-links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .social-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: #6b7280;
    transition: color 0.15s;
  }

  .social-link:hover {
    color: #1e40af;
  }

  .hero-image-wrap {
    flex-shrink: 0;
  }

  .hero-image {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top center;
    border: 4px solid #e5e7eb;
    box-shadow: 0 4px 24px rgb(0 0 0 / 0.12);
  }

  /* About strip */
  .about-strip {
    background: #eff6ff;
    padding: 1.25rem 0;
    border-bottom: 1px solid #bfdbfe;
  }

  .about-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .about-chip {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: #1e3a8a;
    background: white;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid #bfdbfe;
    white-space: nowrap;
  }

  .chip-icon {
    font-size: 0.95rem;
  }

  /* Currently Exploring strip */
  .exploring-strip {
    background: #f0fdf4;
    padding: 1rem 0;
    border-bottom: 1px solid #bbf7d0;
  }

  .exploring-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #15803d;
    text-align: center;
    margin-bottom: 0.6rem;
  }

  .exploring-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
  }

  .exploring-chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: #166534;
    background: white;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    border: 1px solid #bbf7d0;
    white-space: nowrap;
  }

  .exploring-status {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
  }

  .exploring-status.built {
    background: #dcfce7;
    color: #15803d;
  }

  .exploring-status.building {
    background: #fef9c3;
    color: #854d0e;
  }

  .exploring-status.researching {
    background: #ede9fe;
    color: #5b21b6;
  }

  /* Projects grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .projects-cta {
    margin-top: 2rem;
    text-align: center;
  }

  @media (max-width: 640px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
    .hero {
      padding: 3rem 0 2rem;
    }
    .hero-image {
      width: 150px;
      height: 150px;
    }
    .hero-grid {
      flex-direction: column-reverse;
      align-items: flex-start;
    }
  }
</style>
</style>