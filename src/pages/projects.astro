    paper: 'https://github.com/PCSchmidt/finetuning-study/blob/main/notebooks/finetuning_study.pdf',
    notebook: 'https://github.com/PCSchmidt/finetuning-study/blob/main/notebooks/finetuning_study.ipynb',
  },
  {
    title: 'RL Environment + Q-Learning Study',
    description:
      'Custom Windy Gridworld environment with tabular Q-learning and DQN agents, implemented from scratch using Gymnasium and PyTorch. 24 tests with CI.',
    problem:
      'Understanding RL requires building environments and agents from scratch — not just calling library APIs. How do tabular and deep RL methods compare on the same task?',
    approach:
      'Implemented WindyGridWorld (Gymnasium API), tabular ε-greedy Q-learning, and a DQN with experience replay and target network. Systematic comparison of convergence, sample efficiency, and solution quality.',
    impact:
      'Tabular Q-learning converges fast on small state spaces; DQN generalizes but needs replay buffer tuning. Full environment/agent separation following Gymnasium patterns. 24/24 tests passing.',
    tags: ['Reinforcement Learning', 'PyTorch', 'Gymnasium', 'DQN', 'Q-Learning', 'Python'],
    status: 'featured' as const,
    tier: 'more' as const,
    timeframe: 'Spring 2026',
    metrics: ['24 passing tests', 'Tabular + Deep RL agents', 'Custom Gymnasium environment'],
    github: 'https://github.com/PCSchmidt/rl-environment-study',
    evidence: 'https://github.com/PCSchmidt/rl-environment-study/blob/main/notebooks/rl_study.pdf',
    guide: 'https://github.com/PCSchmidt/rl-environment-study/blob/main/DEMO_GUIDE.md',
    paper: 'https://github.com/PCSchmidt/rl-environment-study/blob/main/notebooks/rl_study.pdf',
    notebook: 'https://github.com/PCSchmidt/rl-environment-study/blob/main/notebooks/rl_study.ipynb',
  },
  {
    title: 'Optimizer Deep Dive: From Gradient Descent to Adam',
    description:
      'Pure NumPy implementations of BGD, SGD+Momentum, and Adam optimizers with a from-scratch neural network (backpropagation) trained on MNIST. Includes loss landscape visualization and initialization sensitivity analysis. 29 tests with CI.',
    problem:
      'Most practitioners use optimizer libraries without understanding the math. How do BGD, momentum, and Adam actually differ in convergence behavior across different curvature regimes?',
    approach:
      'Implemented all three optimizers and a feedforward neural network with full backpropagation in pure NumPy. Benchmarked on Rosenbrock, ill-conditioned quadratics (κ=2–500), and MNIST classification. Visualized 3D loss landscapes and gradient norms.',
    impact:
      'Adam achieves ~93% MNIST accuracy vs SGD ~85%. Condition number study shows Adam effectively reduces effective κ. He initialization critical for ReLU networks. 29/29 tests passing, zero external ML dependencies.',
    tags: ['NumPy', 'Optimization', 'Neural Networks', 'Backpropagation', 'MNIST', 'Python'],
    status: 'featured' as const,
    tier: 'more' as const,
    timeframe: 'Spring 2026',
    metrics: ['29 passing tests', '~93% MNIST accuracy (pure NumPy)', '3 optimizers from scratch'],
    github: 'https://github.com/PCSchmidt/optimizer-deep-dive',
    evidence: 'https://github.com/PCSchmidt/optimizer-deep-dive/blob/main/notebooks/optimizer_deep_dive.pdf',
    guide: 'https://github.com/PCSchmidt/optimizer-deep-dive/blob/main/DEMO_GUIDE.md',
    paper: 'https://github.com/PCSchmidt/optimizer-deep-dive/blob/main/notebooks/optimizer_deep_dive.pdf',
    notebook: 'https://github.com/PCSchmidt/optimizer-deep-dive/blob/main/notebooks/optimizer_deep_dive.ipynb',
  },
];

// Three tiers, because when everything is featured nothing is. A hiring manager
// arriving from LinkedIn spends about 90 seconds here; that budget buys one project
// read properly, not thirteen skimmed. Reordering is a one-word edit to `tier`.
const hero = projects.filter((p) => p.tier === 'hero');
const supporting = projects.filter((p) => p.tier === 'supporting');
const more = projects.filter((p) => p.tier === 'more');
---

<Layout
  title="Projects — Chris Schmidt"
  description="ML/AI project portfolio: verified AI systems, computer vision, geospatial intelligence, agent evaluation, and applied ML studies."
>
  <section class="section">
    <div class="container">
      <h1 class="section-title">Projects</h1>
      <p class="section-intro">
        One idea runs through the recent verified-systems work: keep the consequential
        decision in deterministic code, and put an independent check on model output
        before it is trusted. The shorter studies under More work are
        learning and benchmarking projects and do not all follow it. Projects are ordered by what I would most want to discuss,
        not by date. Every case study states the engineering problem, the approach, and
        what was actually measured, including what is still unproven and one result that
        came back negative.
      </p>

      {hero.length > 0 && (
        <div class="tier tier-hero">
          <div class="tier-head">
            <h2 class="tier-title">Current focus</h2>
            <p class="tier-note">The project I would most want to be asked about.</p>
          </div>
          <div class="projects-list">
            {hero.map((project) => (
              <div class="project-detail is-hero">
                <ProjectCard
                  title={project.title}
                  description={project.description}
                  tags={project.tags}
                  status={project.status}
                  metrics={project.metrics}
                  github={project.github}
                  demo={project.demo}
                  demoLabel={project.demoLabel}
                  evidence={project.evidence}
                  guide={project.guide}
                  timeframe={project.timeframe}
                  paper={project.paper}
                  notebook={project.notebook}
                >
                  <div class="case-study">
                    <div class="case-row">
                      <span class="case-label">Problem</span>
                      <p class="case-text">{project.problem}</p>
                    </div>
                    <div class="case-row">
                      <span class="case-label">Approach</span>
                      <p class="case-text">{project.approach}</p>
                    </div>
                    <div class="case-row">
                      <span class="case-label">Impact</span>
                      <p class="case-text">{project.impact}</p>
                    </div>
                  </div>
                </ProjectCard>
              </div>
            ))}
          </div>
        </div>
      )}

      <div class="tier">
        <div class="tier-head">
          <h2 class="tier-title">Selected work</h2>
          <p class="tier-note">The same discipline in many settings: computer vision safety
            monitoring, geospatial change detection, entity resolution, factuality checking,
            code linting, edge language models, multi-camera tracking, calibration, agent
            evaluation, a live intelligence product, and verifiable research agents.</p>
        </div>
        <div class="projects-list">
        {
          supporting.map((project) => (
            <div class="project-detail">
              <ProjectCard
                title={project.title}
                description={project.description}
                tags={project.tags}
                status={project.status}
                metrics={project.metrics}
                github={project.github}
                demo={project.demo}
                demoLabel={project.demoLabel}
                evidence={project.evidence}
                guide={project.guide}
                timeframe={project.timeframe}
                paper={project.paper}
                notebook={project.notebook}
              >
                <div class="case-study">
                  <div class="case-row">
                    <span class="case-label">Problem</span>
                    <p class="case-text">{project.problem}</p>
                  </div>
                  <div class="case-row">
                    <span class="case-label">Approach</span>
                    <p class="case-text">{project.approach}</p>
                  </div>
                  <div class="case-row">
                    <span class="case-label">Impact</span>
                    <p class="case-text">{project.impact}</p>
                  </div>
                </div>
              </ProjectCard>
            </div>
          ))
        }
        </div>
      </div>

      <div class="tier">
        <div class="tier-head">
          <h2 class="tier-title">More work</h2>
          <p class="tier-note">Studies and applications, kept brief on purpose.
            Each links to a repo with setup docs and evidence.</p>
        </div>
        <ul class="more-list">
          {
            more.map((project) => (
              <li class="more-item">
                <div class="more-main">
                  <h3 class="more-title">{project.title}</h3>
                  <p class="more-desc">{project.description.split('. ')[0]}.</p>
                </div>
                <div class="more-links">
                  {project.demo && <a href={project.demo} class="more-link">{project.demoLabel ?? 'Demo'}</a>}
                  {project.github && <a href={project.github} class="more-link">Code</a>}
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="thinking-cta">
        <p>For perspectives on AI engineering, evaluation methodology, and where the field is heading:</p>
        <a href="/thinking" class="btn btn-outline">Read My Thinking Posts →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* --- tiering ------------------------------------------------------- */
  .tier { margin-bottom: 3.25rem; }
  .tier-head { margin-bottom: 1.25rem; }
  .tier-title {
    font-size: 1.05rem; text-transform: uppercase; letter-spacing: .06em;
    margin: 0 0 .25rem; color: #334155;
  }
  .tier-note { margin: 0; font-size: .9rem; color: #64748b; max-width: 62ch; }
  .tier-hero .tier-title { color: #1d4ed8; }
  .tier-hero .project-detail { border-left: 3px solid #1d4ed8; padding-left: 1.1rem; }

  .more-list { list-style: none; margin: 0; padding: 0;
    border-top: 1px solid #e2e8f0; }
  .more-item {
    display: flex; gap: 1rem; align-items: baseline; justify-content: space-between;
    flex-wrap: wrap; padding: .85rem .25rem; border-bottom: 1px solid #e2e8f0;
  }
  .more-main { flex: 1 1 22rem; min-width: 0; }
  .more-title { font-size: .98rem; margin: 0 0 .15rem; font-weight: 600; color: #0f172a; }
  .more-desc { margin: 0; font-size: .86rem; color: #64748b; }
  .more-links { display: flex; gap: .6rem; flex-shrink: 0; }
  .more-link {
    font-size: .82rem; color: #1d4ed8; text-decoration: none;
    border: 1px solid #cbd5e1; border-radius: 5px; padding: .18rem .55rem;
  }
  .more-link:hover { border-color: #1d4ed8; background: #eff6ff; }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .case-study {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 1rem 1.25rem;
  }

  .case-row {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .case-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #1e40af;
    background: #eff6ff;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    white-space: nowrap;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .case-text {
    font-size: 0.875rem;
    color: #4b5563;
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 640px) {
    .case-row {
      flex-direction: column;
      gap: 0.35rem;
    }
  }

  .thinking-cta {
    margin-top: 3rem;
    text-align: center;
    padding: 2rem;
    background: var(--color-accent-bg);
    border-radius: var(--radius-lg);
    border: 1px solid #bfdbfe;
  }

  .thinking-cta p {
    margin-bottom: 1rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }
</style>
