---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
  {
    title: 'Generative AI Journal Summarizer',
    description:
      'Multi-provider LLM gateway with RAG pipeline and ReAct agentic layer for journal entry analysis. Embeds past entries with sentence-transformers + FAISS, retrieves longitudinal context to augment LLM prompts. Agent orchestrates 5 tools (search, sentiment, trends, reflect, suggest) in a multi-step reasoning loop. Supports 17+ model configs across Groq, HuggingFace, OpenAI, and Anthropic with BYOK token vault (AES-256).',
    problem:
      'Journal analysis tools treat each entry in isolation, losing insight from patterns over time. Cloud LLM APIs also differ in availability and cost, requiring flexible provider routing.',
    approach:
      'Built a FastAPI backend with a RAG pipeline (sentence-transformers all-MiniLM-L6-v2, FAISS cosine search, prompt augmentation), multi-provider LLM routing, a BYOK token vault, and a ReAct-style agentic layer built from Groq API primitives (no LangChain) with 5 tools and observable planning traces. Evaluated retrieval with a golden test set and agent accuracy with a 10-case benchmark.',
    impact:
      'RAG retrieval: 0.80 precision@3, 1.0 MRR. Agent eval: 90% pass rate, 0.92 tool recall, 0.77 precision, 4.8s avg latency. Working multi-provider gateway with live demo, provider diagnostics, and reproducible eval harness.',
    tags: ['Python', 'FastAPI', 'RAG', 'FAISS', 'Agentic AI', 'LLM APIs'],
    status: 'featured' as const,
    timeframe: 'Jul 2025 \u2013 Present',
    metrics: ['Retrieval: 0.80 precision@3, 1.0 MRR', 'Agent: 90% pass, 0.92 recall, 4.8s latency', '17+ LLM model configs across 8 providers'],
    github: 'https://github.com/PCSchmidt/generative-ai-journal-summarizer',
    demo: 'https://generative-ai-journal-summarizer.vercel.app',
    evidence: 'https://github.com/PCSchmidt/generative-ai-journal-summarizer/tree/main/evidence/reliability-2026-04-12-final-confirmed',
    guide: 'https://github.com/PCSchmidt/generative-ai-journal-summarizer/blob/main/DEMO_GUIDE.md',
  },
  {
    title: 'AeroIntel — Real-Time Aviation Intelligence Dashboard',
    description:
      'A real-time anomaly detection pipeline over live ADS-B telemetry with no labeled training data. Fuses two commercial feeds, applies Kalman filtering to maintain state across sparse position updates, detects orbital and holding patterns with DBSCAN, and scores deviations with IsolationForest. Claude explains flagged aircraft in plain language. Deployed continuously on Fly.io with CI/CD.',
    problem:
      'Public ADS-B feeds expose raw aircraft positions but not interpretable signals about unusual behavior. An analyst can see thousands of points on a map, but not which aircraft deserve attention or why.',
    approach:
      'Built a FastAPI backend that ingests commercial and military telemetry, maintains in-memory aircraft state, and runs a sequential enrichment pipeline: Kalman filtering for state estimation, DBSCAN for pattern detection, and IsolationForest for anomaly scoring. The backend pushes GeoJSON to a Next.js + MapLibre frontend and exposes natural-language query, region summary, and anomaly explanation endpoints backed by Claude.',
    impact:
      'Built and deployed a full ML inference pipeline processing 11,000+ live aircraft per 60-second cycle, with Kalman state estimation, DBSCAN spatial pattern detection, and IsolationForest anomaly scoring. Captured 4 real Claude anomaly explanations from live flight data, including a US military helicopter (GRZLY71) executing a racetrack surveillance orbit. Implemented Fleet Analytics, on-demand feature vector display, and a collapsible Pattern Drill-Down. Fixed a state persistence bug that was silently discarding anomaly scores between non-scoring cycles. System runs continuously on Fly.io with CI/CD via GitHub Actions. Full technical write-up in CASE_STUDY.md.',
    tags: ['Python', 'FastAPI', 'Kalman Filter', 'DBSCAN', 'IsolationForest', 'Claude API', 'Next.js', 'MapLibre GL'],
    status: 'featured' as const,
    timeframe: 'Apr 2026',
    metrics: ['Full ML pipeline: Kalman + DBSCAN + IsolationForest, no labeled data required', '11,000+ aircraft processed per 60-second inference cycle', '4 real anomaly explanations from live military flight data'],
    github: 'https://github.com/PCSchmidt/aerointel',
    demo: 'https://aerointel-git-main-chris-schmidts-projects.vercel.app',
    evidence: 'https://github.com/PCSchmidt/aerointel/tree/main/evidence',
    guide: 'https://github.com/PCSchmidt/aerointel/blob/main/DEMO_GUIDE.md',
    paper: 'https://github.com/PCSchmidt/aerointel/blob/main/CASE_STUDY.md',
  },
  {
    title: 'Meridian — Agent Harness for AI-Assisted Development',
    description:
      'An agent harness that sits between an AI coding agent and the work, enforcing rules the model cannot hallucinate past. When a gate check fails, a shell hook exits with code 2 and the model’s next action is blocked. An independent evaluator subagent scores each gate’s work in a fresh context — eliminating the self-grading bias that lets agents mark unfinished work "done." Composable YAML gate DAG, schema-validated JSONL memory, and engineer-legible telemetry. Began as a fork of a fellow JHU student’s Syntaris framework.',
    problem:
      'AI coding agents fail predictably on multi-session projects: they declare features "done" before tests run, forget decisions across context resets, grade their own work generously, and drift from the original scope. None of these are prompt-quality problems — you cannot word-craft your way out of a structural failure.',
    approach:
      'Built infrastructure, not prompts. Gates are a project-defined YAML dependency graph enforced by shell hooks that exit 2 to block execution. A Gate Evaluator subagent runs in a fresh context, told "you did not produce this work," and blocks any gate scoring below 7.0. Three schema-validated JSONL memory types persist patterns, session events, and predicted-vs-actual calibration across resets. Every gate transition, block, and verdict is logged to queryable telemetry, and enforcement relocates to the git/CI boundary for non-Claude platforms.',
    impact:
      'Validated the core thesis by experiment: an agent scored its own work 5.5/10 while an independent evaluator scored the same work 2.5/10 — a 3.0-point gap the harness closes mechanically. 238 tests across 18 suites, all three recipes verified end-to-end. Dogfooded on two production projects, where a gate caught stub citation code an agent had marked complete and forced it to be rebuilt as real infrastructure before it could ship as technical debt.',
    tags: ['Bash', 'Claude Code', 'Agent Harness', 'LLM Evaluation', 'Hooks', 'DevTools'],
    status: 'featured' as const,
    timeframe: 'May 2026 – Present',
    metrics: ['Self-grading gap closed: 5.5 → 2.5 (−3.0 pts)', '238 tests across 18 suites', 'Dogfooded on 2 production projects'],
    github: 'https://github.com/PCSchmidt/meridian',
    evidence: 'https://github.com/PCSchmidt/meridian/blob/main/experiment/GENERATOR_EVALUATOR_VALIDATION.md',
    guide: 'https://github.com/PCSchmidt/meridian/blob/main/DEMO_GUIDE.md',
    paper: 'https://github.com/PCSchmidt/meridian/blob/main/MERIDIAN_ARCHITECTURE_DECISIONS.md',
  },
  {
    title: 'Hard Power Intelligence — Markets Intelligence Engine',
    description:
      'A recurring intelligence-production engine that turns scattered public data — SEC filings, federal contract awards, energy and regulatory releases, and news — into source-attributed, confidence-graded briefings across three converging sectors: AI infrastructure, defense, and energy. Live at hardpowerintel.com. Not a chatbot and not a stock-picker: every item shows its basis and confidence, and an entity-resolution graph links each event to the investable company behind it.',
    problem:
      'The data that moves the AI, defense, and energy build-outs — DoD awards, EDGAR filings, NRC licensing, hyperscaler capex, export-control actions — is public but fragmented, slow to read, and disconnected from its market meaning. Serious investors don’t lack data; they lack the time to aggregate it and the tooling to connect a raw event to the security it affects.',
    approach:
      'Built a full production stack: a Next.js reader on Vercel, a FastAPI intelligence engine, and Supabase (Postgres + pgvector). A per-source scheduler pulls four live adapters (USAspending, SEC EDGAR, arXiv, NRC) through a retry/backoff fetcher with DB-level dedup and a circuit breaker; records resolve into a bitemporal entity-resolution graph; change-detection plus graph-grounded RAG generate a cached BLUF brief per desk; an eval gate checks for fabrication and grades each item’s attribution before publish. A daily cron ingests once and publishes all three desks.',
    impact:
      'Live end-to-end and publishing daily from live data. The entity resolver holds precision 1.0 / recall 1.0 with zero false links on a golden set, rendering each item’s companies as clickable entity chips and flagging cross-desk convergence — a company appearing on two or more desks — as the core signal. An interactive Convergence Graph makes the entity network visible, with the cited stories behind each connection and a federal-funding overlay. Payments are built but not yet wired to a processor; turning on subscriptions is the next step to public launch.',
    tags: ['Next.js', 'FastAPI', 'Supabase', 'pgvector', 'RAG', 'Entity Resolution', 'LLM'],
    status: 'featured' as const,
    timeframe: 'Jun 2026 \u2013 Present',
    metrics: ['Live: Next.js + FastAPI + Supabase', 'Entity resolver: 1.0 precision / 1.0 recall', '3 desks, 4 live sources, daily cron'],
    github: 'https://github.com/PCSchmidt/HardPowerIntelligence',
    demo: 'https://hardpowerintel.com/',
    evidence: 'https://hardpowerintel.com/desk/defense',
    guide: 'https://github.com/PCSchmidt/HardPowerIntelligence/blob/main/DEMO_GUIDE.md',
    paper: 'https://github.com/PCSchmidt/HardPowerIntelligence/blob/main/docs/PHILOSOPHY.md',
  },
  {
    title: 'Production Inference Optimization Study',
    description:
      'Applied inference optimization techniques (ONNX export, INT8 quantization, adaptive batching) to SkillSwap\'s all-MiniLM-L6-v2 sentence transformer. Benchmarked cost-latency tradeoffs with p50/p95/p99 measurements across five deployment configurations. Fully tested with CI.',
    problem:
      'Embedding generation for SkillSwap\'s semantic skill-matching needed cheaper, faster inference on CPU without sacrificing match quality or requiring GPU hardware.',
    approach:
      'Exported the production sentence-transformer to ONNX via Hugging Face Optimum, applied INT8 dynamic quantization (88 MB → 23 MB, ~74% reduction), and swept batch sizes 1–64. Benchmarked p50/p95/p99 latency and throughput across PyTorch baseline, ONNX Runtime, and quantized ONNX configurations. Validated accuracy with cosine similarity against the PyTorch baseline.',
    impact:
      'ONNX + INT8 batch=32 achieved 2.9ms p50 latency and 602 req/s — a ~9× throughput improvement over PyTorch single inference. Model size reduced ~74%. Quantized embeddings maintained 0.962 mean cosine similarity vs. baseline. 17 passing tests with GitHub Actions CI.',
    tags: ['ONNX', 'PyTorch', 'Sentence Transformers', 'Benchmarking', 'Quantization'],
    status: 'featured' as const,
    timeframe: 'Apr 2026',
    metrics: ['~9× throughput (602 req/s)', '74% model size reduction', '2.9ms p50 latency'],
    github: 'https://github.com/PCSchmidt/inference-optimization-study',
    evidence: 'https://github.com/PCSchmidt/inference-optimization-study/tree/main/evidence',
    guide: 'https://github.com/PCSchmidt/inference-optimization-study/blob/main/DEMO_GUIDE.md',
    paper: 'https://github.com/PCSchmidt/inference-optimization-study/blob/main/notebooks/inference_optimization_study.pdf',
    notebook: 'https://github.com/PCSchmidt/inference-optimization-study/blob/main/notebooks/inference_optimization_study.ipynb',
  },
  {
    title: 'Generative Modeling Study (β-VAE)',
    description:
      'From-scratch β-VAE implementation in PyTorch for MNIST, with systematic β-sweep ablation (β = 0.1–10) studying the reconstruction–disentanglement tradeoff. 19 tests, CI, and exported evidence plots.',
    problem:
      'Standard VAEs balance reconstruction fidelity against latent space regularity via a single β hyperparameter, but the impact is hard to reason about without hands-on experimentation.',
    approach:
      'Built encoder/decoder with configurable latent dimensions, trained across 6 β values, and measured reconstruction loss, KL divergence, and sample quality. Exported latent space interpolations and reconstructions as evidence.',
    impact:
      'Clear demonstration of how β controls the reconstruction–disentanglement tradeoff. Low β (0.1) gives sharp reconstructions but tangled latents; high β (10) gives smooth latent space but blurry outputs. 19/19 tests passing.',
    tags: ['PyTorch', 'Generative Models', 'VAE', 'Ablation Study', 'Python'],
    status: 'featured' as const,
    timeframe: 'Spring 2026',
    metrics: ['6 β-sweep configurations', '19 passing tests', 'Evidence PNGs exported'],
    github: 'https://github.com/PCSchmidt/generative-modeling-study',
    evidence: 'https://github.com/PCSchmidt/generative-modeling-study/blob/main/notebooks/beta_vae_study.pdf',
    guide: 'https://github.com/PCSchmidt/generative-modeling-study/blob/main/DEMO_GUIDE.md',
    paper: 'https://github.com/PCSchmidt/generative-modeling-study/blob/main/notebooks/beta_vae_study.pdf',
    notebook: 'https://github.com/PCSchmidt/generative-modeling-study/blob/main/notebooks/beta_vae_study.ipynb',
  },
  {
    title: 'Parameter-Efficient Fine-Tuning Study (LoRA)',
    description:
      'Systematic LoRA rank ablation on GPT-2 (124M) for dialogue summarization. Ablates rank [2,4,8,16] x alpha [8,16,32], evaluates with ROUGE + BERTScore, and demonstrates diminishing returns beyond rank 8. CPU-only, fully reproducible.',
    problem:
      'Full fine-tuning of LLMs is expensive. LoRA reduces trainable parameters by 95%+, but how does rank affect quality? Practitioners need empirical guidance for choosing configurations.',
    approach:
      'Applied LoRA to GPT-2 attention layers across 5 rank/alpha configurations on SAMSum (500 train examples). Evaluated each with ROUGE-1/2/L and BERTScore. Visualized training curves, ablation heatmaps, and before/after comparisons.',
    impact:
      'Rank 8 with alpha 16-32 captures most fine-tuning benefit at 0.65% of model parameters. Even rank-2 (202K params) substantially beats zero-shot. Methodology is model-size-agnostic and applies directly to Llama, Mistral, and other transformers.',
    tags: ['LoRA', 'PEFT', 'Transformers', 'Fine-Tuning', 'Ablation Study', 'Python'],
    status: 'featured' as const,
    timeframe: 'Apr 2026',
    metrics: ['5 LoRA configurations ablated', '12 passing tests', '0.65% trainable params (rank 8)'],
    github: 'https://github.com/PCSchmidt/finetuning-study',
    evidence: 'https://github.com/PCSchmidt/finetuning-study/tree/main/results',
    guide: 'https://github.com/PCSchmidt/finetuning-study/blob/main/DEMO_GUIDE.md',
    paper: 'https://github.com/PCSchmidt/finetuning-study/blob/main/notebooks/finetuning_study.pdf',
    notebook: 'https://github.com/PCSchmidt/finetuning-study/blob/main/notebooks/finetuning_study.ipynb',
  },
  {
    title: 'RL Environment + Q-Learning Study',
    description:
      'Custom Windy Gridworld environment with tabular Q-learning and DQN agents, implemented from scratch using Gymnasium and PyTorch. 24 tests with CI.',
    problem:
      'Understanding RL requires building environments and agents from scratch — not just calling library APIs. How do tabular and deep RL methods compare on the same task?',
    approach:
      'Implemented WindyGridWorld (Gymnasium API), tabular ε-greedy Q-learning, and a DQN with experience replay and target network. Systematic comparison of convergence, sample efficiency, and solution quality.',
    impact:
      'Tabular Q-learning converges fast on small state spaces; DQN generalizes but needs replay buffer tuning. Full environment/agent separation following Gymnasium patterns. 24/24 tests passing.',
    tags: ['Reinforcement Learning', 'PyTorch', 'Gymnasium', 'DQN', 'Q-Learning', 'Python'],
    status: 'featured' as const,
    timeframe: 'Spring 2026',
    metrics: ['24 passing tests', 'Tabular + Deep RL agents', 'Custom Gymnasium environment'],
    github: 'https://github.com/PCSchmidt/rl-environment-study',
    evidence: 'https://github.com/PCSchmidt/rl-environment-study/blob/main/notebooks/rl_study.pdf',
    guide: 'https://github.com/PCSchmidt/rl-environment-study/blob/main/DEMO_GUIDE.md',
    paper: 'https://github.com/PCSchmidt/rl-environment-study/blob/main/notebooks/rl_study.pdf',
    notebook: 'https://github.com/PCSchmidt/rl-environment-study/blob/main/notebooks/rl_study.ipynb',
  },
  {
    title: 'Optimizer Deep Dive: From Gradient Descent to Adam',
    description:
      'Pure NumPy implementations of BGD, SGD+Momentum, and Adam optimizers with a from-scratch neural network (backpropagation) trained on MNIST. Includes loss landscape visualization and initialization sensitivity analysis. 29 tests with CI.',
    problem:
      'Most practitioners use optimizer libraries without understanding the math. How do BGD, momentum, and Adam actually differ in convergence behavior across different curvature regimes?',
    approach:
      'Implemented all three optimizers and a feedforward neural network with full backpropagation in pure NumPy. Benchmarked on Rosenbrock, ill-conditioned quadratics (κ=2–500), and MNIST classification. Visualized 3D loss landscapes and gradient norms.',
    impact:
      'Adam achieves ~93% MNIST accuracy vs SGD ~85%. Condition number study shows Adam effectively reduces effective κ. He initialization critical for ReLU networks. 29/29 tests passing, zero external ML dependencies.',
    tags: ['NumPy', 'Optimization', 'Neural Networks', 'Backpropagation', 'MNIST', 'Python'],
    status: 'featured' as const,
    timeframe: 'Spring 2026',
    metrics: ['29 passing tests', '~93% MNIST accuracy (pure NumPy)', '3 optimizers from scratch'],
    github: 'https://github.com/PCSchmidt/optimizer-deep-dive',
    evidence: 'https://github.com/PCSchmidt/optimizer-deep-dive/blob/main/notebooks/optimizer_deep_dive.pdf',
    guide: 'https://github.com/PCSchmidt/optimizer-deep-dive/blob/main/DEMO_GUIDE.md',
    paper: 'https://github.com/PCSchmidt/optimizer-deep-dive/blob/main/notebooks/optimizer_deep_dive.pdf',
    notebook: 'https://github.com/PCSchmidt/optimizer-deep-dive/blob/main/notebooks/optimizer_deep_dive.ipynb',
  },
];
---

<Layout
  title="Projects — Chris Schmidt"
  description="ML/AI project portfolio: inference optimization, generative models, reinforcement learning, and full-stack AI applications."
>
  <section class="section">
    <div class="container">
      <h1 class="section-title">Projects</h1>
      <p class="section-intro">
        Flagship ML/AI projects structured as case studies. Each entry describes the engineering
        problem, my approach, and measurable outcomes. Projects marked <strong>"In Progress"</strong>
        are actively being hardened with deeper evaluation, deployment polish, and expanded writeups.
        Evidence links are provided where available for direct reviewer verification.
      </p>

      <div class="projects-list">
        {
          projects.map((project) => (
            <div class="project-detail">
              <ProjectCard
                title={project.title}
                description={project.description}
                tags={project.tags}
                status={project.status}
                metrics={project.metrics}
                github={project.github}
                demo={project.demo}
                evidence={project.evidence}
                guide={project.guide}
                timeframe={project.timeframe}
                paper={project.paper}
                notebook={project.notebook}
              >
                <div class="case-study">
                  <div class="case-row">
                    <span class="case-label">Problem</span>
                    <p class="case-text">{project.problem}</p>
                  </div>
                  <div class="case-row">
                    <span class="case-label">Approach</span>
                    <p class="case-text">{project.approach}</p>
                  </div>
                  <div class="case-row">
                    <span class="case-label">Impact</span>
                    <p class="case-text">{project.impact}</p>
                  </div>
                </div>
              </ProjectCard>
            </div>
          ))
        }
      </div>

      <div class="thinking-cta">
        <p>For perspectives on AI engineering, evaluation methodology, and where the field is heading:</p>
        <a href="/thinking" class="btn btn-outline">Read My Thinking Posts →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .case-study {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 1rem 1.25rem;
  }

  .case-row {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .case-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #1e40af;
    background: #eff6ff;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    white-space: nowrap;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .case-text {
    font-size: 0.875rem;
    color: #4b5563;
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 640px) {
    .case-row {
      flex-direction: column;
      gap: 0.35rem;
    }
  }

  .thinking-cta {
    margin-top: 3rem;
    text-align: center;
    padding: 2rem;
    background: var(--color-accent-bg);
    border-radius: var(--radius-lg);
    border: 1px solid #bfdbfe;
  }

  .thinking-cta p {
    margin-bottom: 1rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }
</style>
